# Local-only files (never committed)
update-log.txt      # written by the Windows auto-update task
.env                # local deploy overrides (e.g. BIND_PORT)
node_modules/
.DS_Store
*.log

# Python bytecode from the board tools (tools/*.py)
__pycache__/
*.pyc

# Intermediate HTML from tools/gen_diagram.mjs (the committed artifact is the PNG)
docs/neuroster-systems-map.html
